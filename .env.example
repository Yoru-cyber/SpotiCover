# ──────────────────────────────────────────────
# SpotiCover - Environment Variables Template
# ──────────────────────────────────────────────
# Copy this file to .env.local (dev) or .env.production (prod)
# NEVER commit .env.local or .env.production

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Admin (service_role) key for user management — NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Storage (bucket base URL) ──
# Local:  http://127.0.0.1:54321/storage/v1/object/public/user_covers
# Cloud:  https://<project>.supabase.co/storage/v1/object/public/user_covers
NEXT_PUBLIC_SUPABASE_BUCKET_URL=
# ── Cloudfare Turnstile ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# ── Database (Prisma) ──
# Local:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud:  postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Spotify API ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local:  http://localhost:3000/auth/spotify/callback
# Cloud:  https://yourdomain.com/auth/spotify/callback
SPOTIFY_REDIRECT_URI=
