generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cover {
  id            String   @id @default(cuid())
  userId        String
  trackName     String
  artistName    String
  albumImageUrl String
  spotifyUrl    String
  bucketPath    String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, spotifyUrl])
  @@index([userId])
}

model SpotifyToken {
  userId       String   @id
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}
